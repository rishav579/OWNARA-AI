generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  name             String
  emailVerifiedAt  DateTime?
  status           String              @default("active")
  avatarColor      String              @default("#10b981")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deactivatedAt    DateTime?
  approvals        Approval[]          @relation("ApprovalDecidedBy")
  employees        Employee[]          @relation("EmployeeCreatedBy")
  knowledgeDocs    KnowledgeDocument[]
  notifications    Notification[]
  sessions         Session[]
  tasks            Task[]              @relation("TaskAssignedBy")
  ownedWorkspaces  Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  ownerUserId        String
  defaultRegion      String              @default("in-central")
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  suspendedAt        DateTime?
  approvals          Approval[]
  approvalRules      ApprovalRule[]
  auditLogs          AuditLog[]
  collectionCases    CollectionCase[]
  customers          Customer[]
  departments        Department[]
  employees          Employee[]
  employeeMemories   EmployeeMemory[]
  employeeProfiles   EmployeeProfile[]
  employeeSkills     EmployeeSkill[]
  executionContracts ExecutionContract[]
  // ─── Autonomous Learning & Skill Evolution Engine (EMP-002) ───
  outcomeEvaluations  OutcomeEvaluation[]
  skillReinforcements SkillReinforcement[]
  learningPatterns    LearningPattern[]
  employeeWeaknesses  EmployeeWeakness[]
  employeeStrengths   EmployeeStrength[]
  businessOutcomes    BusinessOutcome[]
  careerTimeline      CareerTimelineEntry[]
  achievements        Achievement[]
  employeeAchievements EmployeeAchievement[]
  // ─── end EMP-002 ───
  // ─── AI Employee Communication Engine (COMM-001) ───
  communications       EmployeeCommunication[]
  communicationThreads CommunicationThread[]
  // ─── end COMM-001 ───
  integrations       Integration[]
  invoices           Invoice[]
  documents          KnowledgeDocument[]
  llmUsage           LlmUsage[]
  notifications      Notification[]
  payments           Payment[]
  policies           Policy[]
  reminders          Reminder[]
  tasks              Task[]
  trustScores        TrustScore[]
  owner              User                @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members            WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member")
  status      String    @default("pending")
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  removedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model EmployeeTemplate {
  id                    String     @id @default(cuid())
  name                  String
  role                  String     @unique
  description           String
  defaultJobDescription String
  defaultApprovalRules  String     @default("{}")
  defaultToolNames      String     @default("[]")
  version               Int        @default(1)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  employees             Employee[]
}

model Employee {
  id               String                   @id @default(cuid())
  workspaceId      String
  name             String
  role             String
  templateId       String?
  status           String                   @default("draft")
  state            String                   @default("idle")
  priorState       String?
  jobDescription   String
  boundaries       String                   @default("[]")
  approvalRules    String                   @default("{}")
  tokenUsage       Int                      @default(0)
  tokenCap         Int                      @default(5000000)
  tools            String                   @default("[]")
  pendingApprovals Int                      @default(0)
  taskCount        Int                      @default(0)
  completedTasks   Int                      @default(0)
  createdBy        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  activatedAt      DateTime?
  retiredAt        DateTime?
  approvals        Approval[]
  creator          User                     @relation("EmployeeCreatedBy", fields: [createdBy], references: [id])
  template         EmployeeTemplate?        @relation(fields: [templateId], references: [id])
  workspace        Workspace                @relation(fields: [workspaceId], references: [id])
  capabilities     EmployeeCapability[]
  toolPermissions  EmployeeToolPermission[]
  documents        KnowledgeDocument[]
  tasks            Task[]
  trustScores      TrustScore[]
}

model Tool {
  id                 String                   @id @default(cuid())
  name               String                   @unique
  displayName        String
  description        String
  defaultCriticality String                   @default("non_critical")
  inputSchema        String                   @default("{}")
  outputSchema       String                   @default("{}")
  version            Int                      @default(1)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  permissions        EmployeeToolPermission[]
}

model EmployeeToolPermission {
  id                  String    @id @default(cuid())
  employeeId          String
  toolId              String
  criticalityOverride String?
  grantedBy           String
  grantedAt           DateTime  @default(now())
  revokedAt           DateTime?
  tool                Tool      @relation(fields: [toolId], references: [id])
  employee            Employee  @relation(fields: [employeeId], references: [id])
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  employeeId  String
  assignedBy  String
  title       String
  description String
  status      String     @default("assigned")
  priority    String     @default("medium")
  stepCount   Int        @default(0)
  stepCap     Int        @default(20)
  tokenUsage  Int        @default(0)
  tokenCap    Int        @default(100000)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  approvals   Approval[]
  assigner    User       @relation("TaskAssignedBy", fields: [assignedBy], references: [id])
  employee    Employee   @relation(fields: [employeeId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  steps       TaskStep[]
}

model TaskStep {
  id            String    @id @default(cuid())
  taskId        String
  stepNumber    Int
  stepType      String
  input         String    @default("{}")
  reasoning     String?
  output        String?
  status        String    @default("pending")
  tokens        Int       @default(0)
  durationMs    Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  confidence    Float?
  knowledgeRefs String?
  policyRefs    String?
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Approval {
  id              String    @id @default(cuid())
  workspaceId     String
  taskId          String
  employeeId      String
  tool            String
  toolDisplayName String
  proposedAction  String    @default("{}")
  originalAction  String?
  status          String    @default("pending")
  criticality     String    @default("critical")
  riskScore       Int       @default(50)
  confidence      Float     @default(0.8)
  businessImpact  String?
  policyTrigger   String?
  policyId        String?
  timeoutAt       DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  decision        String?
  modifiedAction  String?
  reason          String?
  createdAt       DateTime  @default(now())
  decider         User?     @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
  task            Task      @relation(fields: [taskId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
}

model KnowledgeDocument {
  id          String    @id @default(cuid())
  workspaceId String
  employeeId  String?
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String
  status      String    @default("processing")
  chunkCount  Int       @default(0)
  uploadedBy  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  removedAt   DateTime?
  uploader    User      @relation(fields: [uploadedBy], references: [id])
  employee    Employee? @relation(fields: [employeeId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model AuditLog {
  id             String    @id @default(cuid())
  workspaceId    String
  sequenceNumber Int
  entryType      String
  actorType      String
  actorId        String?
  actorName      String
  targetType     String?
  targetId       String?
  payload        String    @default("{}")
  previousHash   String?
  entryHash      String
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, sequenceNumber])
}

model Notification {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  type          String
  title         String
  body          String
  referenceType String?
  referenceId   String?
  channel       String    @default("in_app")
  status        String    @default("pending")
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}

model LlmUsage {
  id               String    @id @default(cuid())
  workspaceId      String
  taskId           String?
  employeeId       String?
  provider         String    @default("openai")
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  totalTokens      Int       @default(0)
  costCents        Int       @default(0)
  latencyMs        Int       @default(0)
  status           String    @default("success")
  errorMessage     String?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id])
}

model Policy {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  code        String
  category    String
  description String
  rules       String    @default("[]")
  severity    String    @default("high")
  status      String    @default("active")
  appliesTo   String    @default("all")
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ApprovalRule {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  trigger      String
  condition    String
  action       String    @default("require_approval")
  approverRole String    @default("owner")
  policyId     String?
  priority     Int       @default(100)
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

model TrustScore {
  id                  String    @id @default(cuid())
  workspaceId         String
  employeeId          String
  successRate         Float     @default(1.0)
  approvalRate        Float     @default(1.0)
  humanCorrections    Int       @default(0)
  policyViolations    Int       @default(0)
  tasksCompleted      Int       @default(0)
  moneyRecoveredCents Int       @default(0)
  accuracyScore       Float     @default(1.0)
  overallScore        Float     @default(85.0)
  trend               String    @default("stable")
  trendDelta          Float     @default(0.0)
  computedAt          DateTime  @default(now())
  employee            Employee  @relation(fields: [employeeId], references: [id])
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  headUserId  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String    @unique
  displayName String
  category    String
  description String
  status      String    @default("available")
  logoColor   String
  connectedAt DateTime?
  connectedBy String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Customer {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  email           String
  phone           String?
  gstin           String?
  billingAddress  String?
  paymentTerms    Int              @default(30)
  creditLimit     Int              @default(0)
  status          String           @default("active")
  riskLevel       String           @default("medium")
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  collectionCases CollectionCase[]
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  invoices        Invoice[]
  payments        Payment[]
  reminders       Reminder[]
}

model Invoice {
  id              String           @id @default(cuid())
  workspaceId     String
  customerId      String
  invoiceNumber   String           @unique
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Int
  tax             Int              @default(0)
  total           Int
  amountPaid      Int              @default(0)
  outstanding     Int              @default(0)
  status          String           @default("unpaid")
  paymentTerms    Int              @default(30)
  notes           String?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  collectionCases CollectionCase[]
  customer        Customer         @relation(fields: [customerId], references: [id])
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  payments        Payment[]
  reminders       Reminder[]
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  invoiceId   String
  customerId  String
  amount      Int
  paymentDate DateTime
  method      String    @default("bank_transfer")
  reference   String?
  status      String    @default("completed")
  notes       String?
  recordedBy  String?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Reminder {
  id            String    @id @default(cuid())
  workspaceId   String
  invoiceId     String
  customerId    String
  reminderType  String    @default("email")
  subject       String
  body          String
  status        String    @default("drafted")
  sentAt        DateTime?
  respondedAt   DateTime?
  responseNotes String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  customer      Customer  @relation(fields: [customerId], references: [id])
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
}

model CollectionCase {
  id              String            @id @default(cuid())
  workspaceId     String
  invoiceId       String
  customerId      String
  status          String            @default("open")
  priority        String            @default("medium")
  agingBucket     String            @default("current")
  daysOverdue     Int               @default(0)
  assignedTo      String?
  escalationLevel Int               @default(0)
  resolution      String?
  openedAt        DateTime          @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime          @updatedAt
  customer        Customer          @relation(fields: [customerId], references: [id])
  invoice         Invoice           @relation(fields: [invoiceId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])
  followUps       FollowUpHistory[]
}

model FollowUpHistory {
  id               String         @id @default(cuid())
  collectionCaseId String
  action           String
  description      String
  performedBy      String?
  performedAt      DateTime       @default(now())
  collectionCase   CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
}

model EmployeeMemory {
  id                 String    @id @default(cuid())
  workspaceId        String
  employeeId         String
  memoryType         String
  entityType         String
  entityId           String
  entityLabel        String
  key                String
  value              String
  confidence         Float     @default(0.5)
  source             String    @default("task")
  reinforcementCount Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([employeeId, memoryType, entityType, entityId, key])
  @@index([employeeId, entityType, entityId])
  @@index([employeeId, memoryType])
}

model ExecutionContract {
  id                       String    @id @default(cuid())
  workspaceId              String
  taskId                   String
  employeeId               String
  approvalId               String?
  contractNumber           String
  version                  Int       @default(1)
  parentContractId         String?
  status                   String    @default("draft")
  goal                     String
  proposedAction           String
  confidence               Float
  evidence                 String    @default("[]")
  memoriesUsed             String    @default("[]")
  policiesUsed             String    @default("[]")
  businessImpact           String
  affectedSystems          String    @default("[]")
  rollbackPlan             String
  estimatedBusinessOutcome String
  estimatedTokenCost       Int       @default(0)
  estimatedExecutionTime   Int       @default(0)
  requiredAuthority        String    @default("owner")
  contractHash             String    @unique
  generatedAt              DateTime  @default(now())
  approvedAt               DateTime?
  approvedBy               String?
  rejectedAt               DateTime?
  rejectedBy               String?
  rejectionReason          String?
  supersededAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, contractNumber, version])
  @@index([workspaceId, status])
  @@index([taskId])
  @@index([employeeId])
  @@index([contractHash])
}

model Capability {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String
  category    String
  riskLevel   String               @default("low")
  createdAt   DateTime             @default(now())
  employees   EmployeeCapability[]
}

model EmployeeCapability {
  id           String     @id @default(cuid())
  employeeId   String
  capabilityId String
  grantedBy    String
  createdAt    DateTime   @default(now())
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, capabilityId])
  @@index([employeeId])
}

model EmployeeProfile {
  id                     String    @id @default(cuid())
  employeeId             String    @unique
  workspaceId            String
  employeeType           String    @default("finance_employee")
  department             String    @default("Finance")
  title                  String    @default("Intern")
  version                Int       @default(1)
  experiencePoints       Int       @default(0)
  level                  Int       @default(1)
  completedTasks         Int       @default(0)
  successfulTasks        Int       @default(0)
  failedTasks            Int       @default(0)
  approvalRate           Float     @default(1.0)
  averageConfidence      Float     @default(0.85)
  averageExecutionTime   Int       @default(0)
  moneyRecovered         Int       @default(0)
  invoicesProcessed      Int       @default(0)
  customersHandled       Int       @default(0)
  emailsSent             Int       @default(0)
  tasksAutomated         Int       @default(0)
  hoursSaved             Float     @default(0)
  estimatedBusinessValue Int       @default(0)
  trustScore             Float     @default(85.0)
  accuracyScore          Float     @default(0.90)
  consistencyScore       Float     @default(0.85)
  riskScore              Float     @default(30.0)
  hallucinationRate      Float     @default(0.05)
  humanInterventionRate  Float     @default(0.20)
  skills                 String    @default("[]")
  knowledgeAreas         String    @default("[]")
  specializations        String    @default("[]")
  strongestDomains       String    @default("[]")
  weakDomains            String    @default("[]")
  memoryCount            Int       @default(0)
  reinforcementCount     Int       @default(0)
  capabilitiesGranted    Int       @default(0)
  criticalCapabilities   Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  lastTaskAt             DateTime?
  workspace              Workspace @relation(fields: [workspaceId], references: [id])
}

model EmployeeSkill {
  id          String    @id @default(cuid())
  employeeId  String
  workspaceId String
  name        String
  level       Int       @default(1)
  confidence  Float     @default(0.5)
  usageCount  Int       @default(0)
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([employeeId, name])
  @@index([employeeId])
}

// ═════════════════════════════════════════════════════════════════════════════
// EMP-002 — Autonomous Learning & Skill Evolution Engine
// ═════════════════════════════════════════════════════════════════════════════
//
// Design principles:
//   1. NO fake learning. NO random XP. NO LLM-generated scores.
//      Everything comes from MEASURABLE BUSINESS OUTCOMES.
//   2. Normalized tables — no JSON blobs for core entities.
//      Patterns, strengths, weaknesses, achievements are all queryable.
//   3. Append-only history. Business outcomes never overwrite.
//   4. Incremental updates only — no expensive scans.
//   5. Generic — works for Finance, HR, Sales Ops, Procurement, etc.
//      No domain-specific code in the engine.
//
// All 8 models are workspace-scoped and employee-scoped. IDs are cuid().
// ═════════════════════════════════════════════════════════════════════════════

// ─── 1. Outcome Evaluation ───────────────────────────────────────────────────
// One row per completed task. The deterministic "scorecard" of what happened.
// Generated by evaluateOutcome() after task completion.
model OutcomeEvaluation {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String
  taskId          String   @unique  // one evaluation per task

  // Execution quality (deterministic, from task + steps + approvals)
  stepCount              Int     @default(0)
  toolCallCount          Int     @default(0)
  approvalGateCount      Int     @default(0)
  approvalRejections     Int     @default(0)
  humanOverrides         Int     @default(0)  // manager edited proposed action
  capabilityDenials      Int     @default(0)
  tokenUsage             Int     @default(0)
  executionTimeMs        Int     @default(0)
  rollbackNeeded         Boolean @default(false)

  // Business outcome (measurable, from finance domain — null if not applicable)
  paymentReceived        Boolean @default(false)
  paymentAmount          Int     @default(0)  // in paise
  invoiceResolved        Boolean @default(false)
  customerResponded      Boolean @default(false)
  reminderSentCount      Int     @default(0)

  // SLA
  slaAchieved            Boolean @default(false)
  slaTargetHours         Int     @default(0)
  slaActualHours         Float   @default(0)

  // Errors
  errorCount             Int     @default(0)
  stepFailureCount       Int     @default(0)

  // Confidence accuracy — how close was the employee's confidence to reality?
  // Computed as: avg(step.confidence) for completed steps vs outcome success.
  expectedSuccess        Boolean @default(true)   // employee predicted success
  actualSuccess          Boolean @default(true)   // task actually completed
  confidenceAccuracy     Float   @default(1.0)    // 1.0 = perfect, 0.0 = always wrong

  // Overall quality score (0-100, deterministic formula in engine)
  qualityScore           Int     @default(0)

  // Human corrections count (approvals rejected + overrides + capability denials)
  humanCorrections       Int     @default(0)

  // Free-form outcome summary (deterministic, built from facts)
  outcomeSummary         String  @default("")

  createdAt              DateTime @default(now())

  workspace              Workspace @relation(fields: [workspaceId], references: [id])

  @@index([employeeId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── 2. Skill Reinforcement ──────────────────────────────────────────────────
// Append-only ledger of every reinforcement event for a skill.
// Instead of "skill++", we record WHY the skill was reinforced.
// The skill's level is derived from the sum of reinforcements.
//
// Reinforcement values:
//   positive (+1, +2, +3) = good outcome attributable to this skill
//   negative (-1, -2, -3) = bad outcome attributable to this skill
//
// Level formula (in engine):
//   totalReinforcement = sum of all reinforcement values for this skill
//   level = clamp(1, 10, 1 + floor(totalReinforcement / 5))
//   (every +5 net reinforcement = +1 level)
model SkillReinforcement {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String
  skillName       String   // e.g. "Collections", "Invoice Analysis"
  taskId          String?  // null if not tied to a task
  outcomeId       String?  // link to OutcomeEvaluation

  // Why was this skill reinforced? (deterministic reason code)
  reason          String   // e.g. "successful_collection", "payment_recovered",
                           //      "reminder_approved", "rejected", "rollback"
  reinforcement   Int      @default(0)  // +1, +2, +3, -1, -2, -3
  notes           String   @default("") // human-readable detail

  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@index([employeeId, skillName, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── 3. Learning Pattern ─────────────────────────────────────────────────────
// Detected patterns from repeated outcomes. Queryable & reusable.
// Examples:
//   "FastFreight always pays after second reminder"
//   "Customer X ignores Friday emails"
//   "Invoices above ₹5 lakh need manager approval"
//
// Patterns are detected by deterministic rules in the engine — no LLM.
// Patterns are STORED ONLY — not yet integrated with the Planner.
model LearningPattern {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String

  patternType     String   // "customer_payment_behavior" | "reminder_effectiveness"
                           // | "invoice_risk_indicator" | "communication_preference"
                           // | "approval_correlation"
  entityType      String   @default("customer")  // customer | invoice | reminder | generic
  entityId        String   @default("")          // customerId / invoiceId / "" for generic
  entityLabel     String   @default("")          // human-readable label

  // The pattern itself (deterministic, fact-based)
  pattern         String   // e.g. "pays_after_second_reminder"
  description     String   // human-readable: "FastFreight pays 100% of invoices within 7 days of the 2nd reminder"

  // Evidence (how many times observed)
  observationCount Int     @default(1)
  lastObservedAt  DateTime @default(now())

  // Confidence in the pattern (0-1, increases with observations)
  confidence      Float    @default(0.5)

  // Is this pattern actionable? (can the Planner reuse it?)
  actionable      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  // One pattern per (employee, patternType, entityType, entityId, pattern)
  @@unique([employeeId, patternType, entityType, entityId, pattern])
  @@index([employeeId, patternType])
  @@index([workspaceId, createdAt])
}

// ─── 4. Employee Weakness ────────────────────────────────────────────────────
// Detected repeated failures. Reduces trust.
// Examples: "High rejection rate", "Low confidence", "Frequent human edits"
model EmployeeWeakness {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String

  weaknessType    String   // "high_rejection_rate" | "low_confidence"
                           // | "frequent_human_edits" | "repeated_rollbacks"
                           // | "repeated_sla_misses" | "high_capability_denials"
                           // | "low_accuracy" | "slow_execution"
  description     String   // human-readable

  // Measurable evidence
  metricValue     Float    @default(0)  // e.g. rejection rate = 0.45
  threshold       Float    @default(0)  // e.g. threshold = 0.30
  occurrenceCount Int     @default(1)   // how many tasks triggered this

  // Impact on trust (negative)
  trustImpact     Float    @default(0)  // e.g. -5.0 trust points

  // Is this weakness currently active (vs resolved)?
  status          String   @default("active")  // active | resolved | acknowledged

  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())
  resolvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([employeeId, weaknessType])
  @@index([employeeId, status])
  @@index([workspaceId, createdAt])
}

// ─── 5. Employee Strength ────────────────────────────────────────────────────
// Detected repeated success. Increases trust.
// Examples: "Excellent collections", "High recovery rate", "Fast execution"
model EmployeeStrength {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String

  strengthType    String   // "excellent_collections" | "high_recovery_rate"
                           // | "fast_execution" | "low_escalation"
                           // | "high_approval_rate" | "high_confidence_accuracy"
                           // | "zero_rollbacks" | "consistent_sla"
  description     String   // human-readable

  // Measurable evidence
  metricValue     Float    @default(0)  // e.g. recovery rate = 0.85
  threshold       Float    @default(0)  // e.g. threshold = 0.70
  occurrenceCount Int     @default(1)   // how many tasks triggered this

  // Impact on trust (positive)
  trustImpact     Float    @default(0)  // e.g. +5.0 trust points

  // Is this strength currently active?
  status          String   @default("active")  // active | superseded

  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([employeeId, strengthType])
  @@index([employeeId, status])
  @@index([workspaceId, createdAt])
}

// ─── 6. Business Outcome History (Append-Only) ───────────────────────────────
// Every business outcome is recorded. Never overwritten.
// This is the employee's "ledger of impact".
model BusinessOutcome {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String
  taskId          String?

  outcomeType     String   // "money_recovered" | "invoice_processed"
                           // | "customer_helped" | "hours_saved"
                           // | "task_automated" | "email_sent"
                           // | "approval_avoided" | "escalation_avoided"
                           // | "rollback" | "failure" | "success_streak"
                           // | "largest_recovery"
  amount          Int      @default(0)  // in paise (for money outcomes)
  count           Int      @default(1)  // for countable outcomes
  description     String   @default("")

  // Running totals at the time of this outcome (for historical charts)
  cumulativeMoneyRecovered    Int @default(0)
  cumulativeInvoicesProcessed Int @default(0)
  cumulativeCustomersHelped   Int @default(0)
  cumulativeHoursSaved        Float @default(0)
  cumulativeTasksAutomated    Int @default(0)
  cumulativeEmailsSent        Int @default(0)

  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@index([employeeId, outcomeType, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── 7. Career Timeline Entry ────────────────────────────────────────────────
// Chronological log of every career event. The "LinkedIn activity feed".
model CareerTimelineEntry {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String

  entryType       String   // "level_up" | "skill_promoted" | "skill_learned"
                           // | "strength_detected" | "weakness_detected"
                           // | "weakness_resolved" | "achievement_unlocked"
                           // | "pattern_learned" | "task_completed"
                           // | "task_failed" | "milestone_reached"
                           // | "trust_change" | "major_recovery"
  title           String   // short title
  description     String   // human-readable detail
  metadata        String   @default("{}")  // JSON for extra context (rarely used)

  // The state of the employee at this moment (snapshot)
  levelAtTime     Int      @default(0)
  xpAtTime        Int      @default(0)
  trustAtTime     Float    @default(0)

  taskId          String?  // if related to a task
  outcomeId       String?  // if related to an outcome evaluation

  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@index([employeeId, createdAt])
  @@index([workspaceId, createdAt])
}

// ─── 8. Achievement + EmployeeAchievement (unlock ledger) ────────────────────
// Achievement = a definable milestone (workspace-scoped, definable by admins)
// EmployeeAchievement = the unlock ledger (who earned it, when, evidence)
model Achievement {
  id              String   @id @default(cuid())
  workspaceId     String

  code            String   // e.g. "first_collection", "ten_invoices", "level_5"
  name            String   // "First Collection"
  description     String   // "Successfully collected on the first overdue invoice"
  category        String   @default("performance")  // performance | milestone | quality | learning
  icon            String   @default("award")        // lucide icon name

  // Trigger condition (deterministic, evaluated by the engine)
  triggerType     String   // "task_count" | "money_recovered" | "level_reached"
                           // | "skill_level" | "streak" | "perfect_quality"
  triggerThreshold Int     @default(1)  // e.g. 10 for "10 invoices processed"
  triggerSkillName String  @default("") // for skill_level triggers

  // Trust impact (positive)
  trustImpact     Float    @default(0)  // e.g. +3.0 trust points

  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  unlocks         EmployeeAchievement[]

  @@unique([workspaceId, code])
  @@index([workspaceId, category])
}

model EmployeeAchievement {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String
  achievementId   String

  // Evidence (why was this unlocked?)
  evidence        String   @default("")  // human-readable
  taskId          String?
  outcomeId       String?

  unlockedAt      DateTime @default(now())

  achievement     Achievement @relation(fields: [achievementId], references: [id])
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])

  @@unique([employeeId, achievementId])
  @@index([employeeId, unlockedAt])
  @@index([workspaceId, unlockedAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// COMM-001 — AI Employee Communication Engine
// ═════════════════════════════════════════════════════════════════════════════
//
// The universal messaging layer for every AI Employee in BIHARI AI.
// Allows AI Employees to communicate with:
//   - Humans (managers, owners)
//   - Other AI Employees (employee-to-employee coordination)
//   - Future external systems (via webhook/API adapters)
//
// This is NOT a chat system. It is structured business communication.
// Every message has a type, priority, business context, explanation,
// evidence, confidence, recommended action, and expected outcome.
//
// Design principles:
//   1. Humans never receive raw AI reasoning — the engine transforms
//      internal reasoning into professional business language.
//   2. Every communication is explainable (why, evidence, confidence, impact).
//   3. Threaded conversations with replies, acknowledgements, resolution.
//   4. Deterministic scoring to avoid spam, merge similar alerts, throttle.
//   5. Every communication becomes permanent memory (Learning Engine).
//   6. Every communication generates audit events (Audit Chain).
//   7. Generic and domain-independent — works for Finance, HR, Procurement,
//      Back Office, Sales Ops, Compliance, Legal, IT, Customer Support.
//
// All models are workspace-scoped. IDs are cuid().
// ═════════════════════════════════════════════════════════════════════════════

// ─── Communication Thread ────────────────────────────────────────────────────
// Groups related messages into a conversation. A thread starts with an
// initial message and can have replies, follow-ups, and escalations.
model CommunicationThread {
  id              String   @id @default(cuid())
  workspaceId     String
  subject         String

  // Who started the thread
  startedByEmployeeId String?
  startedByUserId     String?

  // Related entities (all optional — threads can span multiple)
  relatedTaskId      String?
  relatedCustomerId  String?
  relatedInvoiceId   String?

  // Thread status
  status          String   @default("active")  // active | waiting | resolved | escalated

  // Priority (highest among messages)
  priority        String   @default("medium")  // low | medium | high | critical

  // Communication type (the thread's primary type)
  communicationType String @default("notification")

  // Scoring (deterministic — computed from messages)
  messageCount    Int      @default(0)
  participantCount Int     @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  lastMessageAt   DateTime?

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  messages        EmployeeCommunication[]

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, priority])
  @@index([startedByEmployeeId])
}

// ─── Employee Communication (the message) ────────────────────────────────────
// A single structured business communication from an AI Employee (or system).
// This is the core entity — every message the engine produces is stored here.
model EmployeeCommunication {
  id              String   @id @default(cuid())
  workspaceId     String
  threadId        String?

  // ─── Sender ──────────────────────────────────────────────────────────────
  senderEmployeeId String?   // null if sent by system/human
  senderUserId     String?   // null if sent by employee
  senderName       String    // cached for quick display
  senderType       String    // employee | user | system

  // ─── Receiver ────────────────────────────────────────────────────────────
  receiverType     String    // human | employee | system | all_humans | all_employees
  receiverEmployeeId String? // null if receiver is human/system/all
  receiverUserId   String?   // null if receiver is employee/system/all
  receiverName     String    // cached for quick display

  // ─── Communication metadata ──────────────────────────────────────────────
  communicationType String   // notification | recommendation | escalation |
                             // clarification_request | information_request |
                             // approval_request | coordination_message |
                             // status_update | completion_report | warning |
                             // critical_alert
  priority         String    @default("medium")  // low | medium | high | critical

  // ─── Content (transformed into professional business language) ───────────
  subject          String    // short, professional subject line
  summary          String    // 1-2 sentence executive summary
  explanation      String    // full professional explanation (the "body")

  // ─── Business context (what this communication is about) ─────────────────
  relatedTaskId    String?
  relatedContractId String?
  relatedCustomerId String?
  relatedInvoiceId String?
  relatedApprovalId String?
  relatedReminderId String?

  // ─── Explainability (why this message exists) ────────────────────────────
  whyExists        String    // why this message was sent
  evidence         String    @default("[]")  // JSON array of {source, fact, weight}
  confidence       Float     @default(0.85)  // 0-1
  businessImpact   String    // human-readable business impact
  recommendedAction String   // what the receiver should do
  expectedOutcome  String    // what's expected to happen if action is taken

  // ─── Attachments + actions ───────────────────────────────────────────────
  attachments      String    @default("[]")  // JSON array of {type, label, ref}
  actionButtons    String    @default("[]")  // JSON array of {label, action, style}

  // ─── Status ──────────────────────────────────────────────────────────────
  status           String    @default("sent")  // sent | delivered | read | acknowledged | resolved | ignored | escalated

  // ─── Scoring (deterministic — computed by the engine) ────────────────────
  qualityScore     Int       @default(0)  // 0-100, deterministic
  isDuplicate      Boolean   @default(false)
  duplicateOfId    String?   // if this is a duplicate, points to the original
  isThrottled      Boolean   @default(false)
  mergedIntoId     String?   // if merged, points to the merged message

  // ─── Timestamps ──────────────────────────────────────────────────────────
  createdAt        DateTime @default(now())
  readAt           DateTime?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  escalatedAt      DateTime?

  // ─── Response tracking (for Learning Engine) ─────────────────────────────
  responseTimeMs   Int?   // time from sent → first response (for effectiveness scoring)
  responseAction   String?  // approve | reject | acknowledge | ignore | resolve | escalate

  workspace        Workspace @relation(fields: [workspaceId], references: [id])
  thread           CommunicationThread? @relation(fields: [threadId], references: [id])
  parentCommunication EmployeeCommunication? @relation("CommunicationReplies", fields: [parentCommunicationId], references: [id])
  parentCommunicationId String?
  replies          EmployeeCommunication[] @relation("CommunicationReplies")
  mergedInto       EmployeeCommunication? @relation("CommunicationMerges", fields: [mergedIntoId], references: [id])
  mergedMessages   EmployeeCommunication[] @relation("CommunicationMerges")

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, receiverType, receiverEmployeeId, status])
  @@index([workspaceId, receiverType, receiverUserId, status])
  @@index([workspaceId, senderEmployeeId, createdAt])
  @@index([workspaceId, communicationType, priority])
  @@index([workspaceId, createdAt])
  @@index([threadId, createdAt])
}
