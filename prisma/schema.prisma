// BIHARI AI — Prisma Schema (V1)
// Based on DDS-001 Database Design Specification, adapted for SQLite.
// Portable to PostgreSQL: arrays → JSON, String IDs → UUID, add pgvector for embeddings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth & Workspace ───────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  status          String   @default("active") // active | suspended | deactivated
  avatarColor     String   @default("#10b981")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deactivatedAt   DateTime?

  workspaceMembers WorkspaceMember[]
  sessions         Session[]
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  tasks            Task[]      @relation("TaskAssignedBy")
  approvals        Approval[]  @relation("ApprovalDecidedBy")
  knowledgeDocs    KnowledgeDocument[]
  employees        Employee[]  @relation("EmployeeCreatedBy")
  notifications    Notification[]
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  ownerUserId   String
  defaultRegion String   @default("in-central")
  status        String   @default("active") // active | suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  suspendedAt   DateTime?

  members    WorkspaceMember[]
  employees  Employee[]
  tasks      Task[]
  approvals  Approval[]
  auditLogs  AuditLog[]
  documents  KnowledgeDocument[]
  notifications Notification[]
  llmUsage   LlmUsage[]
  policies   Policy[]
  approvalRules ApprovalRule[]
  trustScores TrustScore[]
  departments Department[]
  integrations Integration[]
  customers  Customer[]
  invoices   Invoice[]
  payments   Payment[]
  reminders  Reminder[]
  collectionCases CollectionCase[]

  owner User @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // owner | member
  status      String   @default("pending") // pending | active | removed
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?
  removedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

// ─── AI Employees ───────────────────────────────────────────────────────────

model EmployeeTemplate {
  id                   String   @id @default(cuid())
  name                 String
  role                 String   @unique
  description          String
  defaultJobDescription String
  defaultApprovalRules String   @default("{}") // JSON
  defaultToolNames     String   @default("[]") // JSON array
  version              Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  role        String
  templateId  String?
  status      String   @default("draft") // draft | active | paused | retired
  state       String   @default("idle")  // idle | assigned | planning | executing | waiting_approval | completed | failed | paused | stopped
  priorState  String?
  jobDescription String
  boundaries  String   @default("[]") // JSON array
  approvalRules String @default("{}") // JSON
  tokenUsage  Int      @default(0)
  tokenCap    Int      @default(5000000)
  tools       String   @default("[]") // JSON array of tool names
  pendingApprovals Int @default(0)
  taskCount   Int      @default(0)
  completedTasks Int   @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activatedAt DateTime?
  retiredAt   DateTime?

  workspace     Workspace           @relation(fields: [workspaceId], references: [id])
  template      EmployeeTemplate?   @relation(fields: [templateId], references: [id])
  creator       User                @relation("EmployeeCreatedBy", fields: [createdBy], references: [id])
  tasks         Task[]
  approvals     Approval[]
  documents     KnowledgeDocument[]
  toolPermissions EmployeeToolPermission[]
  trustScores  TrustScore[]
}

model Tool {
  id                  String   @id @default(cuid())
  name                String   @unique
  displayName         String
  description         String
  defaultCriticality  String   @default("non_critical") // non_critical | critical
  inputSchema         String   @default("{}") // JSON
  outputSchema        String   @default("{}") // JSON
  version             Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  permissions EmployeeToolPermission[]
}

model EmployeeToolPermission {
  id           String   @id @default(cuid())
  employeeId   String
  toolId       String
  criticalityOverride String? // null = use tool default
  grantedBy    String
  grantedAt    DateTime @default(now())
  revokedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  tool     Tool     @relation(fields: [toolId], references: [id])
}

// ─── Tasks & Steps ──────────────────────────────────────────────────────────

model Task {
  id            String   @id @default(cuid())
  workspaceId   String
  employeeId    String
  assignedBy    String
  title         String
  description   String
  status        String   @default("assigned") // assigned | planning | executing | waiting_approval | completed | failed | paused | stopped
  priority      String   @default("medium")   // low | medium | high
  stepCount     Int      @default(0)
  stepCap       Int      @default(20)
  tokenUsage    Int      @default(0)
  tokenCap      Int      @default(100000)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  employee    Employee   @relation(fields: [employeeId], references: [id])
  assigner    User       @relation("TaskAssignedBy", fields: [assignedBy], references: [id])
  steps       TaskStep[]
  approvals   Approval[]
}

model TaskStep {
  id         String   @id @default(cuid())
  taskId     String
  stepNumber Int
  stepType   String   // plan | reasoning | tool_call | approval_gate | observed | policy_check | knowledge_used
  input      String   @default("{}") // JSON
  reasoning  String?
  output     String?  // JSON
  status     String   @default("pending") // pending | running | completed | failed | skipped
  tokens     Int      @default(0)
  durationMs Int      @default(0)
  // Phase 3: explainability enrichment
  policyRefs String?  // JSON array of policy codes checked
  knowledgeRefs String? // JSON array of document chunks used
  confidence Float?   // 0.0-1.0 for this step
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─── Approvals ──────────────────────────────────────────────────────────────

model Approval {
  id            String   @id @default(cuid())
  workspaceId   String
  taskId        String
  employeeId    String
  tool          String
  toolDisplayName String
  proposedAction String  @default("{}") // JSON
  originalAction String? // JSON — AI's original before human edit
  status        String   @default("pending") // pending | approved | rejected | modified | expired
  criticality   String   @default("critical")
  riskScore     Int      @default(50) // 0-100
  confidence    Float    @default(0.8) // 0.0-1.0
  businessImpact String? // text description
  policyTrigger String?  // e.g. "POL-001: Refund Authorization Limit"
  policyId      String?
  timeoutAt     DateTime?
  decidedBy     String?
  decidedAt     DateTime?
  decision      String?  // approved | rejected | modified
  modifiedAction String? // JSON
  reason        String?
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  task      Task      @relation(fields: [taskId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  decider   User?     @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id])
}

// ─── Knowledge ──────────────────────────────────────────────────────────────

model KnowledgeDocument {
  id          String   @id @default(cuid())
  workspaceId String
  employeeId  String?
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String
  status      String   @default("processing") // processing | ready | failed | removed
  chunkCount  Int      @default(0)
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  removedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  uploader  User      @relation(fields: [uploadedBy], references: [id])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  workspaceId    String
  sequenceNumber Int
  entryType      String
  actorType      String   // user | employee | system
  actorId        String?
  actorName      String
  targetType     String?
  targetId       String?
  payload        String   @default("{}") // JSON
  previousHash   String?
  entryHash      String
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, sequenceNumber])
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  type         String   // approval_pending | task_completed | task_failed | employee_paused
  title        String
  body         String
  referenceType String?
  referenceId  String?
  channel      String   @default("in_app")
  status       String   @default("pending") // pending | delivered | read | failed
  readAt       DateTime?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

// ─── LLM Usage ──────────────────────────────────────────────────────────────

model LlmUsage {
  id              String   @id @default(cuid())
  workspaceId     String
  taskId          String?
  employeeId      String?
  provider        String   @default("openai")
  model           String
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  costCents       Int      @default(0)
  latencyMs       Int      @default(0)
  status          String   @default("success")
  errorMessage    String?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// ─── Phase 3: Trust & Governance ────────────────────────────────────────────

model Policy {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  code        String   // e.g. POL-001
  category    String   // financial | data_access | communication | escalation | compliance
  description String
  rules       String   @default("[]") // JSON array of rule expressions
  severity    String   @default("high") // low | medium | high | critical
  status      String   @default("active") // active | draft | archived
  appliesTo   String   @default("all") // all | role:customer_support_agent | etc.
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model ApprovalRule {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  trigger       String   // e.g. send_email, refund_above_threshold, customer_data_access
  condition     String   // JSON: { field: "amount", op: ">", value: 2000 }
  action        String   @default("require_approval") // require_approval | auto_approve | auto_reject | escalate
  approverRole  String   @default("owner") // owner | manager | department_head
  policyId      String?
  priority      Int      @default(100)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model TrustScore {
  id              String   @id @default(cuid())
  workspaceId     String
  employeeId      String
  successRate     Float    @default(1.0)    // 0.0 - 1.0
  approvalRate    Float    @default(1.0)    // approved / total decisions
  humanCorrections Int     @default(0)      // times human modified AI output
  policyViolations Int     @default(0)
  tasksCompleted  Int      @default(0)
  moneyRecoveredCents Int  @default(0)
  accuracyScore   Float    @default(1.0)    // 0.0 - 1.0
  overallScore    Float    @default(85.0)   // 0 - 100
  trend           String   @default("stable") // up | down | stable
  trendDelta      Float    @default(0.0)
  computedAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
}

model Department {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  headUserId  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Integration {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String   @unique // quickbooks | zoho | tally | slack | teams | outlook | gmail | sap | salesforce | hubspot
  displayName String
  category    String   // accounting | communication | crm | erp
  description String
  status      String   @default("available") // available | connected | error
  logoColor   String
  connectedAt DateTime?
  connectedBy String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// ─── Finance Domain Layer ───────────────────────────────────────────────────
// Real AR / Collections entities. The Finance Employee reasons over these
// and mutates them through the existing runtime trust loop.

model Customer {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  email         String
  phone         String?
  gstin         String?   // GST Identification Number (India)
  billingAddress String?
  paymentTerms  Int      @default(30) // days
  creditLimit   Int      @default(0)  // in rupees
  status        String   @default("active") // active | inactive | blocked
  riskLevel     String   @default("medium") // low | medium | high
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id])
  invoices      Invoice[]
  payments      Payment[]
  reminders     Reminder[]
  collectionCases CollectionCase[]
}

model Invoice {
  id              String    @id @default(cuid())
  workspaceId     String
  customerId      String
  invoiceNumber   String    @unique
  issueDate       DateTime
  dueDate         DateTime
  subtotal        Int       // in paise (1 rupee = 100 paise)
  tax             Int       @default(0)
  total           Int       // subtotal + tax
  amountPaid      Int       @default(0)
  outstanding     Int       @default(0) // total - amountPaid
  status          String    @default("unpaid") // unpaid | partially_paid | paid | overdue | written_off
  paymentTerms    Int       @default(30) // days
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  customer        Customer   @relation(fields: [customerId], references: [id])
  payments        Payment[]
  reminders       Reminder[]
  collectionCases CollectionCase[]
}

model Payment {
  id              String   @id @default(cuid())
  workspaceId     String
  invoiceId       String
  customerId      String
  amount          Int       // in paise
  paymentDate     DateTime
  method          String    @default("bank_transfer") // bank_transfer | upi | cheque | cash | card
  reference       String?   // transaction reference
  status          String    @default("completed") // pending | completed | failed | reversed
  notes           String?
  recordedBy      String?
  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
}

model Reminder {
  id              String   @id @default(cuid())
  workspaceId     String
  invoiceId       String
  customerId      String
  reminderType    String   @default("email") // email | sms | phone_call | letter
  subject         String
  body            String
  status          String   @default("drafted") // drafted | sent | failed | responded
  sentAt          DateTime?
  respondedAt     DateTime?
  responseNotes   String?
  createdBy       String?  // employee or user who created it
  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
}

model CollectionCase {
  id              String   @id @default(cuid())
  workspaceId     String
  invoiceId       String
  customerId      String
  status          String   @default("open") // open | escalated | resolved | closed
  priority        String   @default("medium") // low | medium | high | critical
  agingBucket     String   @default("current") // current | 1_30 | 31_60 | 61_90 | 90_plus
  daysOverdue     Int      @default(0)
  assignedTo      String?  // employee ID
  escalationLevel Int      @default(0) // 0 = none, 1 = manager, 2 = legal
  resolution      String?  // how it was resolved
  openedAt        DateTime @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  followUps       FollowUpHistory[]
}

model FollowUpHistory {
  id              String   @id @default(cuid())
  collectionCaseId String
  action          String   // reminder_sent | phone_call | email_sent | escalation | customer_responded | payment_received
  description     String
  performedBy     String?  // employee or user ID
  performedAt     DateTime @default(now())

  collectionCase  CollectionCase @relation(fields: [collectionCaseId], references: [id], onDelete: Cascade)
}
