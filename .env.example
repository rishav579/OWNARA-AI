# ─────────────────────────────────────────────────────────────────────────────
# BIHARI AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# This file contains NO secrets — only placeholders and defaults.
# The real `.env` file is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# BIHARI AI is database-portable (see src/lib/concurrency.ts).
#
# SQLite (default — zero-ops, perfect for local dev & demos):
DATABASE_URL="file:./db/custom.db"
#
# PostgreSQL (production — multi-worker, multi-workspace):
#   1. Set DATABASE_URL below
#   2. Change `provider = "postgresql"` in prisma/schema.prisma
#   3. Run `bun run db:push`
# DATABASE_URL="postgresql://user:password@localhost:5432/bihari?schema=public"

# ─── Auth (REQUIRED in production) ───────────────────────────────────────────
# Secret used to sign JWT access/refresh tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ─── LLM Provider (REQUIRED for real AI) ─────────────────────────────────────
# Gemini is the default LLM provider (free tier available).
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.0-flash"
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Optional LLM Providers ──────────────────────────────────────────────────
# OpenAI (not required — Gemini is default)
# OPENAI_API_KEY=""

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=""

# ─── SMTP Email (REQUIRED in production for real email) ──────────────────────
# When SMTP_HOST is not set, emails use MOCK TRANSPORT (status: sent_mock).
# Production MUST configure real SMTP — mock transport is not acceptable.
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# SMTP_FROM="noreply@yourdomain.com"
# SMTP_FROM_NAME="BIHARI AI"

# ─── CORS (REQUIRED in production) ───────────────────────────────────────────
# Comma-separated list of allowed origins for cross-origin requests.
# Example: "https://app.bihari.ai,https://bihari.ai"
# CORS_ALLOWED_ORIGINS="https://your-production-domain.com"

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
# In production: NODE_ENV="production"
