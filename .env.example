# ─────────────────────────────────────────────────────────────────────────────
# BIHARI AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# This file contains NO secrets — only placeholders and defaults.
# The real `.env` file is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL 16+. This project uses PostgreSQL exclusively.
# The worker depends on SELECT ... FOR UPDATE SKIP LOCKED (PostgreSQL-only).
DATABASE_URL="postgresql://user:password@localhost:5432/bihari?schema=public"

# ─── Auth (REQUIRED in production) ───────────────────────────────────────────
# Secret used to sign JWT access/refresh tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ─── LLM Provider (REQUIRED for real AI) ─────────────────────────────────────
# Gemini is the default LLM provider (free tier available).
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Optional LLM Providers ──────────────────────────────────────────────────
# OpenAI (not required — Gemini is default)
# OPENAI_API_KEY=""

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=""

# ─── SMTP Email (OPTIONAL) ───────────────────────────────────────────────────
# When SMTP_HOST is not set, reminder emails are logged to console.
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# SMTP_FROM="noreply@yourdomain.com"
# SMTP_FROM_NAME="BIHARI AI"

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
